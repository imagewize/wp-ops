#!/usr/bin/env bash
# wp-ops - Unified CLI wrapper for all wp-ops tools
#
# A single entry point for all WordPress operations tools, scripts, and utilities.
# Auto-discovers executable scripts and provides categorized help.
#
# Usage: wp-ops [category] [command] [args...]
#        wp-ops --help
#        wp-ops --json list
#        wp-ops search <term>
#        wp-ops doctor
#        wp-ops scripts backup db example.com production
#
# Categories: scripts, trellis, wp-cli, bedrock, nginx, wordpress-utilities, troubleshooting
#
# Install: ./install.sh (adds this repo to your PATH)

# Use compat mode for older bash versions (macOS ships 3.2)
set -e

# =============================================================================
# Configuration
# =============================================================================

# Resolve symlinks (e.g. /opt/homebrew/bin/wp-ops -> this file) so REPO_ROOT
# points at the actual wp-ops checkout, not the symlink's own directory.
WP_OPS_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$WP_OPS_SOURCE" ]]; do
    WP_OPS_SOURCE_DIR="$(cd "$(dirname "$WP_OPS_SOURCE")" && pwd)"
    WP_OPS_SOURCE="$(readlink "$WP_OPS_SOURCE")"
    [[ "$WP_OPS_SOURCE" != /* ]] && WP_OPS_SOURCE="${WP_OPS_SOURCE_DIR}/${WP_OPS_SOURCE}"
done
REPO_ROOT="$(cd "$(dirname "$WP_OPS_SOURCE")" && pwd)"

# Categories to scan, in order of priority
CATEGORIES=(
    "scripts"
    "trellis"
    "wp-cli"
    "bedrock"
    "nginx"
    "wordpress-utilities"
    "troubleshooting"
    "mcp-server"
)

# Category display names (parallel array to CATEGORIES)
CATEGORY_DISPLAY_NAMES=(
    "Scripts"
    "Trellis"
    "WP-CLI"
    "Bedrock"
    "Nginx"
    "WordPress Utilities"
    "Troubleshooting"
    "MCP Server"
)

# =============================================================================
# Colors & Symbols
# =============================================================================

# Only colorize when writing to a real terminal, colors weren't explicitly
# disabled (NO_COLOR), and the terminal actually supports color.
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1 \
    && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
    BOLD=$(tput bold)
    DIM=$(tput dim)
    RESET=$(tput sgr0)
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    CYAN=$(tput setaf 6)
    MAGENTA=$(tput setaf 5)
else
    BOLD=""
    DIM=""
    RESET=""
    RED=""
    GREEN=""
    YELLOW=""
    CYAN=""
    MAGENTA=""
fi

CHECK="✓"
CROSS="✗"
WARN="!"

# Commands that execute on the server rather than on this machine. They read
# /srv/www/<site>/logs/ as local files and use GNU `date -d`, and are invoked by
# streaming them to the host: ssh web@host 'bash -s' < run-monitoring.sh. Running
# them here fails on a missing log path, which reads as a broken command rather
# than as "wrong machine" — so wp-ops says so up front instead.
SERVER_SIDE_COMMANDS="
scripts/monitoring/traffic-monitor
scripts/monitoring/security-monitor
scripts/monitoring/ai-bot-monitor
scripts/monitoring/run-monitoring
"

is_server_side_command() {
    local command_key="$1"
    case "$SERVER_SIDE_COMMANDS" in
        *"
${command_key}
"*) return 0 ;;
    esac
    return 1
}

# Those scripts date-filter with `date -d "N hours ago"`, which is GNU-only —
# macOS's BSD date rejects -d outright. So "just point it at a local log file"
# is only true where GNU date is the `date` on PATH.
has_gnu_date() {
    date -d "1 hour ago" +%s >/dev/null 2>&1
}

# The toolkit's version lives in CHANGELOG.md (Keep a Changelog format), so read
# it from there instead of maintaining a second copy that silently drifts.
get_version() {
    local version
    version=$(grep -m1 -oE '^## \[[0-9]+\.[0-9]+\.[0-9]+\]' "${REPO_ROOT}/CHANGELOG.md" 2>/dev/null \
        | tr -d '#[] ')
    echo "${version:-unknown}"
}

# =============================================================================
# Data Structures
# =============================================================================

# We'll use files to store the discovered commands
# This avoids associative array issues with bash 3.2
COMMAND_FILE=$(mktemp /tmp/wp-ops-commands.XXXXXX)
CATEGORY_FILE=$(mktemp /tmp/wp-ops-categories.XXXXXX)

# Cleanup on exit
trap "rm -f '$COMMAND_FILE' '$CATEGORY_FILE'" EXIT

# =============================================================================
# Command Discovery
# =============================================================================

# File format for COMMAND_FILE:
# command_key|description

# File format for CATEGORY_FILE:
# category|command_key1,command_key2,...

# Header comments are written for someone reading the file, not for a one-line
# catalog entry, so tidy them up: drop the "script.sh - " self-reference many of
# them open with, keep only the first sentence (headers routinely wrap a
# paragraph across several comment lines), and cap the length so the catalog's
# columns stay aligned.
clean_description() {
    local description="$1"
    local script_path="$2"
    local filename
    filename=$(basename "$script_path")

    description=$(echo "$description" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    description="${description#${filename}}"
    description=$(echo "$description" | sed -E 's/^[[:space:]]*[-—:][[:space:]]*//')

    # First sentence only — "Foo (in place). Trims whitespace," becomes "Foo (in
    # place)." rather than a fragment ending mid-clause.
    if [[ "$description" == *". "* ]]; then
        description="${description%%. *}."
    fi

    description=$(echo "$description" | sed -e 's/[[:space:],;:]*$//')

    if [[ ${#description} -gt 72 ]]; then
        description="${description:0:71}…"
    fi

    echo "$description"
}

discover_commands() {
    > "$COMMAND_FILE"
    > "$CATEGORY_FILE"

    for i in "${!CATEGORIES[@]}"; do
        category="${CATEGORIES[$i]}"
        category_dir="${REPO_ROOT}/${category}"

        if [[ ! -d "$category_dir" ]]; then
            continue
        fi

        # Collect all commands for this category first
        local category_commands=""

        # Only the trellis category holds Ansible playbooks (trellis/backup,
        # trellis/monitoring). Other categories' *.yml files are config data
        # (e.g. bedrock/wp-cli-config/wp-cli.yml), not runnable commands.
        local name_matchers=(-name "*.sh" -o -name "*.js")
        if [[ "$category" == "trellis" ]]; then
            name_matchers+=(-o -name "*.yml")
        fi
        # scripts/ is the only category with standalone Python utilities
        # (e.g. scripts/images/openverse_search.py) — elsewhere *.py would
        # collide with WordPress/Bedrock reference code that isn't runnable.
        if [[ "$category" == "scripts" ]]; then
            name_matchers+=(-o -name "*.py")
        fi
        # wp-cli and bedrock are the only categories whose *.php files are
        # standalone WP-CLI scripts (wp eval-file / a registered wp command).
        # Elsewhere (e.g. wordpress-utilities snippets) *.php is reference
        # code meant to be copied into a theme, not run directly.
        if [[ "$category" == "wp-cli" || "$category" == "bedrock" ]]; then
            name_matchers+=(-o -name "*.php")
        fi
        # wordpress-utilities holds copy-paste-into-a-theme reference snippets
        # (PHP includes, CSS, JS) rather than runnable scripts, so its *.php
        # and *.css files are discovered too (*.js already matches above),
        # all handled by the "snippet" mode below instead of being executed.
        if [[ "$category" == "wordpress-utilities" ]]; then
            name_matchers+=(-o -name "*.php" -o -name "*.css")
        fi

        while IFS= read -r -d '' script_path; do
            if [[ "$script_path" == "${REPO_ROOT}/wp-ops" ]]; then
                continue
            fi

            relative_path="${script_path#${REPO_ROOT}/}"
            command_key="${relative_path%.sh}"
            command_key="${command_key%.js}"
            command_key="${command_key%.yml}"
            command_key="${command_key%.php}"
            command_key="${command_key%.css}"
            command_key="${command_key%.py}"

            description=""
            if [[ -f "$script_path" ]]; then
                case "$script_path" in
                    *.js|*.php|*.css)
                        # JS/PHP/CSS files document themselves with a docblock
                        # ("* text") or line comments ("// text"), not shell
                        # "#" comments.
                        description=$(head -20 "$script_path" | grep -m1 -E '^\s*\*\s+\S' | sed -E 's/^[[:space:]]*\*[[:space:]]*//')
                        if [[ -z "$description" ]]; then
                            description=$(head -20 "$script_path" | grep -m1 -E '^\s*//\s*\S' | sed -E 's#^[[:space:]]*//[[:space:]]*##')
                        fi
                        ;;
                    *.py)
                        # Python files document themselves with a single-line
                        # module docstring ("""text"""), not shell "#" comments.
                        description=$(head -5 "$script_path" | grep -m1 -E '^"""[^"]+"""$' | sed -E 's/^"""(.*)"""$/\1/')
                        ;;
                    *)
                        description=$(head -20 "$script_path" | grep -m1 -E '^#\s' | sed 's/^#\s*//')
                        ;;
                esac
                description=$(clean_description "$description" "$script_path")
                if [[ -z "$description" ]]; then
                    description=$(basename "$command_key")
                fi
            fi

            echo "${command_key}|${description}" >> "$COMMAND_FILE"

            # Add to category commands
            if [[ -z "$category_commands" ]]; then
                category_commands="$command_key"
            else
                category_commands="${category_commands},${command_key}"
            fi

        done < <(find "$category_dir" -type f \( "${name_matchers[@]}" \) ! -name "wp-ops" ! -name "variable-check.yml" ! -name "transient-debug-browser.php" -print0)
        
        # Write category line
        if [[ -n "$category_commands" ]]; then
            echo "${category}|${category_commands}" >> "$CATEGORY_FILE"
        fi
    done
}

get_description() {
    local command_key="$1"
    grep "^${command_key}|" "$COMMAND_FILE" 2>/dev/null | head -1 | cut -d'|' -f2-
}

get_category_commands() {
    local category="$1"
    grep "^${category}|" "$CATEGORY_FILE" 2>/dev/null | head -1 | cut -d'|' -f2-
}

# Emitted in CATEGORIES order (most-used first), not alphabetically — that
# ordering is curated, and sorting would throw it away.
get_active_categories() {
    local category
    for category in "${CATEGORIES[@]}"; do
        if grep -q "^${category}|" "$CATEGORY_FILE" 2>/dev/null; then
            echo "$category"
        fi
    done
}

get_category_display_name() {
    local category="$1"
    local i
    for i in "${!CATEGORIES[@]}"; do
        if [[ "${CATEGORIES[$i]}" == "$category" ]]; then
            echo "${CATEGORY_DISPLAY_NAMES[$i]}"
            return 0
        fi
    done
    echo "$category"
}

# nginx/ and troubleshooting/ hold guides and Nginx config templates, not
# runnable scripts, so they never produce commands. They're still real parts of
# the toolkit, so treat them as documentation categories rather than letting
# 'wp-ops nginx' dead-end on "no commands found".
category_is_docs_only() {
    local category="$1"
    [[ -d "${REPO_ROOT}/${category}" ]] \
        && ! grep -q "^${category}|" "$CATEGORY_FILE" 2>/dev/null
}

print_category_docs() {
    local category="$1"
    local category_display
    category_display=$(get_category_display_name "$category")

    echo "${BOLD}${category_display}${RESET} ${DIM}(documentation, no runnable commands)${RESET}"
    echo ""

    local doc
    while IFS= read -r doc; do
        printf "  ${CYAN}%s${RESET}\n" "${doc#${REPO_ROOT}/}"
    done < <(find "${REPO_ROOT}/${category}" -type f -name "*.md" | sort)
    echo ""
    echo "${DIM}These are guides and config templates — open them in your editor, or copy${RESET}"
    echo "${DIM}the .conf.j2 templates into your Trellis project's nginx-includes/.${RESET}"
    echo ""
}

get_all_commands() {
    cut -d'|' -f1 "$COMMAND_FILE" 2>/dev/null | sort
}

# Subdirectory a command lives in below its category, e.g. for category
# "scripts" and command_key "scripts/release/release-plugin" this returns
# "release". Returns "" for commands directly in the category root.
get_command_subgroup() {
    local category="$1"
    local command_key="$2"
    local remainder="${command_key#${category}/}"

    if [[ "$remainder" == */* ]]; then
        echo "${remainder%/*}"
    fi
}

# =============================================================================
# Help Output
# =============================================================================

print_header() {
    echo ""
    echo "${BOLD}${CYAN}__        ______        ___  ____  ____  "
    echo "\ \      / /  _ \      / _ \|  _ \/ ___| "
    echo " \ \ /\ / /| |_) |____| | | | |_) \___ \ "
    echo "  \ V  V / |  __/_____| |_| |  __/ ___) |"
    echo "   \_/\_/  |_|         \___/|_|   |____/ ${RESET}"
    echo ""
    echo "  ${BOLD}WordPress Operations Tools${RESET}"
    echo "  ${DIM}A unified CLI for modern WordPress development & devops${RESET}"
    echo ""
}

print_usage() {
    echo "Usage:"
    echo "  wp-ops                           Interactive picker (or list, when piped)"
    echo "  wp-ops [category] [command]      Run a command"
    echo "  wp-ops [category] --help         Show commands in a category"
    echo "  wp-ops [command] --help          Show a command's own help"
    echo "  wp-ops [command] --where         Print the path to a command's script"
    echo ""
    echo "  wp-ops search <term>             Search commands by name or description"
    echo "  wp-ops doctor                    Check dependencies and environment"
    echo "  wp-ops --help, -h                Show this help message"
    echo "  wp-ops --version, -v             Show version"
    echo "  wp-ops --json                    Output command list as JSON"
    echo "  wp-ops --completion              Show bash completion script"
    echo ""
}

print_categories() {
    echo "${BOLD}Available Categories:${RESET}"
    echo ""

    local category category_display cmd_list command_count noun
    for category in "${CATEGORIES[@]}"; do
        category_display=$(get_category_display_name "$category")

        if category_is_docs_only "$category"; then
            printf "  ${CYAN}%-25s${RESET} ${DIM}%-20s (docs only)${RESET}\n" \
                "$category_display" "$category"
            continue
        fi

        cmd_list=$(get_category_commands "$category")
        [[ -z "$cmd_list" ]] && continue

        command_count=$(echo "$cmd_list" | tr ',' '\n' | wc -l | tr -d ' ')
        noun="commands"
        [[ "$command_count" -eq 1 ]] && noun="command"
        printf "  ${CYAN}%-25s${RESET} ${DIM}%-20s (%d %s)${RESET}\n" \
            "$category_display" "$category" "$command_count" "$noun"
    done
    echo ""
}

print_category_commands() {
    local category="$1"

    local category_display
    category_display=$(get_category_display_name "$category")

    local cmd_list=$(get_category_commands "$category")

    if [[ -z "$cmd_list" ]]; then
        if category_is_docs_only "$category"; then
            print_category_docs "$category"
            return 1
        fi
        echo "${YELLOW}No commands found in category: $category_display${RESET}"
        return 1
    fi

    echo "${BOLD}${category_display} Commands:${RESET}"
    echo ""

    local sorted_commands
    sorted_commands=$(echo "$cmd_list" | tr ',' '\n' | sort)

    # Sorting the full command_key naturally clusters commands that share a
    # "category/subgroup/" prefix, so a subgroup change only needs a simple
    # comparison against the previous iteration, not a second pass.
    local last_subgroup="__unset__"
    for cmd_key in $sorted_commands; do
        local subgroup
        subgroup=$(get_command_subgroup "$category" "$cmd_key")

        if [[ "$subgroup" != "$last_subgroup" ]]; then
            [[ "$last_subgroup" != "__unset__" ]] && echo ""
            [[ -n "$subgroup" ]] && echo "  ${BOLD}${MAGENTA}${subgroup}${RESET}"
            last_subgroup="$subgroup"
        fi

        # The subgroup heading above already carries the "category/subgroup/"
        # prefix, so repeating it per row only overflows the column. The bare
        # name is also what you'd type: `wp-ops trellis database-backup`.
        local description tag=""
        description=$(get_description "$cmd_key")
        is_server_side_command "$cmd_key" && tag="${YELLOW}(server)${RESET} "
        printf "    ${CYAN}%-32s${RESET} %s${DIM}%s${RESET}\n" "$(basename "$cmd_key")" "$tag" "$description"
    done
    echo ""
}

print_all_commands() {
    for category in $(get_active_categories); do
        print_category_commands "$category"
    done
}

print_json() {
    local first=true
    echo "["
    
    for category in $(get_active_categories); do
        local cmd_list=$(get_category_commands "$category")
        
        for cmd_key in $(echo "$cmd_list" | tr ',' '\n' | sort); do
            local description
            description=$(get_description "$cmd_key")
            
            if [[ "$first" == true ]]; then
                first=false
            else
                echo ","
            fi
            
            description=$(echo "$description" | sed 's/\\/\\\\/g; s/"/\\"/g')

            local runs_on="local"
            is_server_side_command "$cmd_key" && runs_on="server"

            printf '  {"category": "%s", "command": "%s", "description": "%s", "path": "%s", "runs_on": "%s"}' \
                "$category" "$cmd_key" "$description" "$cmd_key" "$runs_on"
        done
    done
    
    echo ""
    echo "]"
}

# =============================================================================
# Command Execution
# =============================================================================

get_script_path() {
    local command_key="$1"
    
    if [[ -f "${REPO_ROOT}/${command_key}.sh" ]]; then
        echo "${REPO_ROOT}/${command_key}.sh"
        return 0
    fi
    
    if [[ -f "${REPO_ROOT}/${command_key}" ]]; then
        echo "${REPO_ROOT}/${command_key}"
        return 0
    fi
    
    if [[ -f "${REPO_ROOT}/${command_key}.js" ]]; then
        echo "${REPO_ROOT}/${command_key}.js"
        return 0
    fi

    if [[ -f "${REPO_ROOT}/${command_key}.yml" ]]; then
        echo "${REPO_ROOT}/${command_key}.yml"
        return 0
    fi

    if [[ -f "${REPO_ROOT}/${command_key}.php" ]]; then
        echo "${REPO_ROOT}/${command_key}.php"
        return 0
    fi

    if [[ -f "${REPO_ROOT}/${command_key}.css" ]]; then
        echo "${REPO_ROOT}/${command_key}.css"
        return 0
    fi

    if [[ -f "${REPO_ROOT}/${command_key}.py" ]]; then
        echo "${REPO_ROOT}/${command_key}.py"
        return 0
    fi

    return 1
}

# A Trellis project is a parent directory holding a trellis/ansible.cfg — so
# from anywhere inside one (the trellis/ dir itself, the Bedrock site next to
# it, a theme deep inside that site), walking up finds it. Saves exporting
# TRELLIS_DIR when you're already standing in the project you mean.
#
# The walk stops below $HOME on purpose. A generic parent like ~/code holds many
# unrelated checkouts, and matching a sibling ~/code/trellis from ~/code/wp-ops
# would silently aim destructive playbooks (database-push!) at the wrong
# project. Detections are also confirmed before use — see require_trellis_dir.
detect_trellis_dir() {
    local dir="$PWD"
    local stop_at="${HOME:-/}"
    local previous="$PWD"

    while [[ -n "$dir" && "$dir" != "/" && "$dir" != "$stop_at" ]]; do
        # Standing in the Trellis directory itself.
        if [[ -f "${dir}/ansible.cfg" && -d "${dir}/group_vars" ]]; then
            echo "$dir"
            return 0
        fi

        # $dir contains a trellis/ — but so does any parent that merely holds a
        # Trellis checkout among unrelated repos (~/code/trellis sitting next to
        # ~/code/wp-ops). Standing in the project root is unambiguous; from
        # deeper down it's only really *this* project when the directory we
        # walked up through is the project's own Bedrock site (web/wp), not a
        # sibling that happens to live alongside the Trellis checkout.
        if [[ -f "${dir}/trellis/ansible.cfg" ]]; then
            if [[ "$dir" == "$PWD" || -d "${previous}/web/wp" ]]; then
                echo "${dir}/trellis"
                return 0
            fi
        fi

        previous="$dir"
        dir=$(dirname "$dir")
    done

    return 1
}

# Likewise for a Bedrock site: web/wp/ is Bedrock's WordPress core directory,
# and composer.json sits at its root.
detect_wp_site_dir() {
    local dir="$PWD"
    local stop_at="${HOME:-/}"

    while [[ -n "$dir" && "$dir" != "/" && "$dir" != "$stop_at" ]]; do
        if [[ -d "${dir}/web/wp" && -f "${dir}/composer.json" ]]; then
            echo "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done

    return 1
}

# An auto-detected directory is a convenience, not an assumption worth acting
# on unprompted: these commands back up, overwrite, and push databases. Confirm
# interactively, and refuse to guess at all when there's nobody to ask.
confirm_detected_dir() {
    local var_name="$1"
    local value="$2"

    if [[ ! -t 0 || ! -t 1 ]]; then
        echo "${RED}${CROSS} ${var_name} is not set.${RESET}"
        echo ""
        echo "Detected a candidate at ${value}, but wp-ops won't assume it"
        echo "non-interactively. Set it explicitly:"
        echo ""
        echo "  export ${var_name}=${value}"
        echo ""
        return 1
    fi

    echo "${YELLOW}${WARN} ${var_name} is not set.${RESET}"
    echo "Detected from the current directory: ${BOLD}${value}${RESET}"
    echo ""

    local reply
    read -r -p "Use it for this command? [y/N] " reply
    echo ""

    if [[ "$reply" =~ ^[Yy] ]]; then
        return 0
    fi

    echo "Cancelled. Set it explicitly instead:"
    echo ""
    echo "  export ${var_name}=/path/to/your/project"
    echo ""
    return 1
}

# Ansible playbooks (trellis/backup, trellis/monitoring) run against a real
# Trellis project's ansible.cfg/inventory/group_vars, not against this repo,
# so they need to know where that project lives.
require_trellis_dir() {
    if [[ -z "${TRELLIS_DIR:-}" ]]; then
        local detected
        if detected=$(detect_trellis_dir); then
            confirm_detected_dir "TRELLIS_DIR" "$detected" || return 1
            TRELLIS_DIR="$detected"
            export TRELLIS_DIR
        else
            echo "${RED}${CROSS} TRELLIS_DIR is not set.${RESET}"
            echo ""
            echo "Ansible playbook commands run against a real Trellis project (they read"
            echo "its ansible.cfg, inventory, and group_vars/), so wp-ops needs to know"
            echo "where that project lives. Either run this from inside the project, or:"
            echo ""
            echo "  export TRELLIS_DIR=/path/to/your/trellis"
            echo ""
            return 1
        fi
    fi

    if [[ ! -f "${TRELLIS_DIR}/ansible.cfg" ]]; then
        echo "${RED}${CROSS} TRELLIS_DIR (${TRELLIS_DIR}) doesn't look like a Trellis project (no ansible.cfg found).${RESET}"
        return 1
    fi

    return 0
}

execute_playbook() {
    local command_key="$1"
    local script_path="$2"
    shift 2

    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        local description
        description=$(get_description "$command_key")
        echo "Usage: wp-ops $command_key -e site=<site> -e env=<development|staging|production> [-e key=value ...]"
        echo ""
        echo "Description: $description"
        echo ""
        echo "Playbook: $script_path"
        echo "Runs via ansible-playbook against the Trellis project at \$TRELLIS_DIR"
        echo "(currently: ${TRELLIS_DIR:-not set})"
        return 0
    fi

    if ! command -v ansible-playbook >/dev/null 2>&1; then
        echo "${RED}${CROSS} ansible-playbook not found on PATH. Install Ansible first.${RESET}"
        return 1
    fi

    require_trellis_dir || return 1

    local exit_code=0
    (cd "$TRELLIS_DIR" && ansible-playbook "$script_path" "$@") || exit_code=$?

    if [[ -t 1 ]]; then
        echo ""
        if [[ $exit_code -eq 0 ]]; then
            echo "${GREEN}${CHECK} ${command_key} completed${RESET}"
        else
            echo "${RED}${CROSS} ${command_key} exited with code ${exit_code}${RESET}"
        fi
    fi

    return "$exit_code"
}

# PHP scripts under wp-cli/ and bedrock/ run through WP-CLI against a real
# WordPress/Bedrock install, not against this repo, so (like TRELLIS_DIR for
# Ansible) wp-ops needs to know where that site lives.
require_wp_site_dir() {
    if [[ -z "${WP_SITE_DIR:-}" ]]; then
        local detected
        if detected=$(detect_wp_site_dir); then
            confirm_detected_dir "WP_SITE_DIR" "$detected" || return 1
            WP_SITE_DIR="$detected"
            export WP_SITE_DIR
        else
            echo "${RED}${CROSS} WP_SITE_DIR is not set.${RESET}"
            echo ""
            echo "WP-CLI script commands run against a real WordPress/Bedrock site, so"
            echo "wp-ops needs to know where that project lives (the directory you'd"
            echo "normally cd into before running 'wp ...'). Either run this from inside"
            echo "the site, or:"
            echo ""
            echo "  export WP_SITE_DIR=/path/to/your/bedrock-site"
            echo ""
            return 1
        fi
    fi

    if [[ ! -d "$WP_SITE_DIR" ]]; then
        echo "${RED}${CROSS} WP_SITE_DIR (${WP_SITE_DIR}) is not a directory.${RESET}"
        return 1
    fi

    return 0
}

# Command name a WP-CLI command file registers with WP_CLI::add_command(),
# e.g. "pattern validate" from `WP_CLI::add_command( 'pattern validate', ... )`.
get_registered_wp_command() {
    local script_path="$1"
    grep -m1 -oE "add_command\([[:space:]]*['\"][^'\"]+['\"]" "$script_path" \
        | sed -E "s/add_command\([[:space:]]*['\"]//" | sed -E "s/['\"]$//"
}

execute_php_command() {
    local command_key="$1"
    local script_path="$2"
    shift 2

    # A file that registers a WP_CLI_Command class (e.g.
    # wp-cli-pattern-validate.php) must be loaded with --require and invoked
    # by its registered command name; everything else is a plain script run
    # top-to-bottom via `wp eval-file`.
    local wp_command=""
    if grep -q "extends WP_CLI_Command" "$script_path" 2>/dev/null; then
        wp_command=$(get_registered_wp_command "$script_path")
    fi

    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        local description
        description=$(get_description "$command_key")
        echo "Description: $description"
        echo ""
        echo "Script: $script_path"
        echo "Runs via WP-CLI against the site at \$WP_SITE_DIR (currently: ${WP_SITE_DIR:-not set})"
        echo ""
        if [[ -n "$wp_command" ]]; then
            echo "Usage: wp-ops $command_key [${wp_command} args...]"
            echo "Runs as: wp --require=$(basename "$script_path") ${wp_command} [args...]"
        else
            echo "Usage: wp-ops $command_key [args...]"
            echo "Runs as: wp eval-file $(basename "$script_path") [args...]"
        fi
        return 0
    fi

    if ! command -v wp >/dev/null 2>&1; then
        echo "${RED}${CROSS} wp (WP-CLI) not found on PATH. Install WP-CLI first.${RESET}"
        return 1
    fi

    require_wp_site_dir || return 1

    local exit_code=0
    if [[ -n "$wp_command" ]]; then
        # $wp_command intentionally unquoted: registered names like "pattern
        # validate" are two CLI words, not one argument.
        (cd "$WP_SITE_DIR" && wp --require="$script_path" $wp_command "$@") || exit_code=$?
    else
        (cd "$WP_SITE_DIR" && wp eval-file "$script_path" "$@") || exit_code=$?
    fi

    if [[ -t 1 ]]; then
        echo ""
        if [[ $exit_code -eq 0 ]]; then
            echo "${GREEN}${CHECK} ${command_key} completed${RESET}"
        else
            echo "${RED}${CROSS} ${command_key} exited with code ${exit_code}${RESET}"
        fi
    fi

    return "$exit_code"
}

# wordpress-utilities files are copy-paste-into-a-theme reference snippets
# (PHP includes, CSS, browser JS) with no meaningful "run" behavior of their
# own, so instead of executing them, wp-ops prints or clipboard-copies them.
find_clipboard_cmd() {
    if command -v pbcopy >/dev/null 2>&1; then
        echo "pbcopy"
    elif command -v xclip >/dev/null 2>&1; then
        echo "xclip -selection clipboard"
    elif command -v xsel >/dev/null 2>&1; then
        echo "xsel --clipboard --input"
    elif command -v clip.exe >/dev/null 2>&1; then
        echo "clip.exe"
    fi
}

execute_snippet() {
    local command_key="$1"
    local script_path="$2"
    shift 2

    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        local description
        description=$(get_description "$command_key")
        echo "Description: $description"
        echo ""
        echo "File: $script_path"
        echo ""
        echo "This is a reference snippet meant to be copied into a WordPress"
        echo "theme or plugin, not run directly — wp-ops just prints it."
        echo ""
        echo "Usage: wp-ops $command_key            Print the snippet"
        echo "       wp-ops $command_key --copy      Copy it to the clipboard"
        echo "       wp-ops $command_key --path      Print only the file path"
        return 0
    fi

    if [[ "${1:-}" == "--path" ]]; then
        echo "$script_path"
        return 0
    fi

    if [[ "${1:-}" == "--copy" ]]; then
        local clip_cmd
        clip_cmd=$(find_clipboard_cmd)

        if [[ -z "$clip_cmd" ]]; then
            echo "${RED}${CROSS} No clipboard tool found (tried pbcopy, xclip, xsel, clip.exe).${RESET}"
            echo "Use 'wp-ops $command_key --path' to get the file path instead."
            return 1
        fi

        $clip_cmd < "$script_path"
        if [[ -t 1 ]]; then
            echo "${GREEN}${CHECK} Copied $(basename "$script_path") to clipboard${RESET}"
        fi
        return 0
    fi

    if [[ -t 1 ]]; then
        echo "${DIM}# ${script_path}${RESET}"
        echo ""
        cat "$script_path"
        echo ""
        echo "${DIM}Reference snippet — copy it into your project (wp-ops does not run it). Try --copy or --path.${RESET}"
    else
        # Piped/redirected: raw content only, so `wp-ops ... > footer.php` works.
        cat "$script_path"
    fi
    return 0
}

print_server_side_guidance() {
    local command_key="$1"
    local script_path="$2"
    local relative_path="${script_path#${REPO_ROOT}/}"

    echo "${YELLOW}${WARN} ${command_key} runs on the server, not here.${RESET}"
    echo ""
    echo "It reads /srv/www/<site>/logs/access.log directly and uses GNU 'date -d',"
    echo "so it has to execute on the Trellis host. Stream it over SSH — nothing"
    echo "needs to be installed there:"
    echo ""
    echo "  ${BOLD}ssh web@example.com 'bash -s' < ${relative_path}${RESET}"
    echo ""
    echo "Arguments go after the redirect, e.g. a different log and time window:"
    echo ""
    echo "  ${BOLD}ssh web@example.com 'bash -s' < ${relative_path} \\"
    echo "      /srv/www/example.com/logs/access.log 24${RESET}"
    echo ""
    echo "${DIM}Accurate time filtering needs gawk on the server (Ubuntu ships mawk;${RESET}"
    echo "${DIM}apt install gawk). Without it the script falls back to a line estimate.${RESET}"
    echo ""
    if has_gnu_date; then
        echo "${DIM}Already have a log file on this machine? Pass its path and it runs here:${RESET}"
        echo "${DIM}  wp-ops ${command_key} /path/to/access.log${RESET}"
    else
        echo "${DIM}Running it against a log file copied here needs GNU date, which this${RESET}"
        echo "${DIM}machine doesn't have — see 'wp-ops ${command_key} <file>' for how to get it.${RESET}"
    fi
}

print_gnu_date_required() {
    local command_key="$1"
    local script_path="$2"
    local relative_path="${script_path#${REPO_ROOT}/}"

    echo "${RED}${CROSS} ${command_key} needs GNU date, which isn't the 'date' on this PATH.${RESET}"
    echo ""
    echo "It filters log lines by time with \`date -d \"N hours ago\"\`. macOS ships"
    echo "BSD date, which rejects -d, so the run would fail partway through."
    echo ""
    echo "Either run it on the server, where date is GNU already:"
    echo ""
    echo "  ${BOLD}ssh web@example.com 'bash -s' < ${relative_path}${RESET}"
    echo ""
    echo "or put GNU coreutils ahead of the BSD tools on this machine:"
    echo ""
    echo "  ${BOLD}brew install coreutils${RESET}"
    echo "  ${BOLD}export PATH=\"\$(brew --prefix coreutils)/libexec/gnubin:\$PATH\"${RESET}"
    echo ""
    echo "${DIM}gnubin puts GNU versions under their plain names, so 'date' becomes GNU date.${RESET}"
}

execute_command() {
    local command_key="$1"
    shift

    local script_path
    script_path=$(get_script_path "$command_key")

    if [[ -z "$script_path" ]]; then
        echo "${RED}${CROSS} Command not found: $command_key${RESET}"
        echo ""
        echo "${YELLOW}Did you mean:${RESET}"
        suggest_similar "$command_key"
        return 1
    fi

    # Handled before dispatch so it works for every command type — the file you'd
    # read, edit, or copy into a project is often what you actually want.
    if [[ "${1:-}" == "--where" ]]; then
        echo "$script_path"
        return 0
    fi

    if is_server_side_command "$command_key"; then
        case "${1:-}" in
            --help|-h) ;;
            *)
                # /srv/www is the Trellis web root: present when we're actually
                # on the server (run it), absent on a workstation. An explicit
                # readable file argument is an intentional "I have the log here"
                # — honoured, but only where GNU date exists to run it, since
                # otherwise it dies several screens in on `date: illegal option`.
                if [[ ! -d /srv/www ]]; then
                    if [[ ! -f "${1:-}" ]]; then
                        print_server_side_guidance "$command_key" "$script_path"
                        return 1
                    fi
                    if ! has_gnu_date; then
                        print_gnu_date_required "$command_key" "$script_path"
                        return 1
                    fi
                fi
                ;;
        esac
    fi

    if [[ "$command_key" == wordpress-utilities/* ]]; then
        execute_snippet "$command_key" "$script_path" "$@"
        return $?
    fi

    if [[ "$script_path" == *.yml ]]; then
        execute_playbook "$command_key" "$script_path" "$@"
        return $?
    fi

    if [[ "$script_path" == *.php ]]; then
        execute_php_command "$command_key" "$script_path" "$@"
        return $?
    fi

    if [[ ! -x "$script_path" ]]; then
        chmod +x "$script_path"
    fi
    
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        # Buffer output so a failed probe (e.g. a script that treats --help as
        # a positional file argument and errors on stdout) never leaks to the
        # user; only a successful probe's output gets printed.
        local help_output
        if help_output=$("$script_path" --help 2>&1); then
            echo "$help_output"
            return 0
        elif help_output=$("$script_path" -h 2>&1); then
            echo "$help_output"
            return 0
        else
            local description
            description=$(get_description "$command_key")
            echo "Usage: wp-ops $command_key [args...]"
            echo ""
            echo "Description: $description"
            echo ""
            echo "Script: $script_path"
            echo ""
            echo "Run '$(basename "$script_path") --help' for script-specific options"
            return 0
        fi
    fi
    
    local exit_code=0
    "$script_path" "$@" || exit_code=$?

    if [[ -t 1 ]]; then
        echo ""
        if [[ $exit_code -eq 0 ]]; then
            echo "${GREEN}${CHECK} ${command_key} completed${RESET}"
        else
            echo "${RED}${CROSS} ${command_key} exited with code ${exit_code}${RESET}"
        fi
    fi

    return "$exit_code"
}

# Every command_key whose basename is exactly $1. Usually one, but some names
# legitimately repeat across subdirectories (scripts/images/convert-to-webp and
# scripts/patterns/convert-to-webp), and silently running whichever sorts first
# is the wrong answer.
find_commands_by_basename() {
    local name="$1"
    local category_filter="${2:-}"
    local cmd_key

    for cmd_key in $(get_all_commands); do
        if [[ -n "$category_filter" && "$cmd_key" != "${category_filter}/"* ]]; then
            continue
        fi
        if [[ "$(basename "$cmd_key")" == "$name" ]]; then
            echo "$cmd_key"
        fi
    done
}

print_ambiguous() {
    local name="$1"
    shift

    local first_match="$1"

    echo "${YELLOW}${WARN} '${name}' matches more than one command:${RESET}"
    echo ""
    local cmd_key
    for cmd_key in "$@"; do
        printf "  ${CYAN}%-40s${RESET} ${DIM}%s${RESET}\n" "$cmd_key" "$(get_description "$cmd_key")"
    done
    echo ""
    echo "Run it by its full name, e.g. ${BOLD}wp-ops ${first_match}${RESET}"
}

suggest_similar() {
    local input="$1"
    local best_match=""
    local best_score=0
    
    for cmd_key in $(get_all_commands); do
        local score=0
        local cmd_name
        cmd_name=$(basename "$cmd_key")
        
        if [[ "$cmd_name" == *"$input"* ]]; then
            score=$(( ${#cmd_name} - ${#input} + 5 ))
        fi
        
        if [[ "$cmd_name" == "$input"* ]]; then
            score=$(( score + 10 ))
        fi
        
        if [[ $score -gt $best_score ]]; then
            best_score=$score
            best_match="$cmd_key"
        fi
    done
    
    if [[ -n "$best_match" && $best_score -gt 0 ]]; then
        echo "  wp-ops $best_match"
    fi
}

