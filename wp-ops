# Most commands here shell out to tools this repo deliberately doesn't vendor
# (Ansible, WP-CLI, ImageMagick, Playwright...). Without a preflight you only
# find out which one is missing partway through an operation.
check_binary() {
    local binary="$1"
    local purpose="$2"
    local required="$3"

    if command -v "$binary" >/dev/null 2>&1; then
        printf "  ${GREEN}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}%s${RESET}\n" "$CHECK" "$binary" "$purpose"
        return 0
    fi

    if [[ "$required" == "required" ]]; then
        printf "  ${RED}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}%s${RESET}\n" "$CROSS" "$binary" "$purpose"
    else
        printf "  ${YELLOW}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}%s${RESET}\n" "$WARN" "$binary" "$purpose"
    fi
    return 1
}

check_env_dir() {
    local var_name="$1"
    local purpose="$2"
    local detector="$3"

    local value="${!var_name:-}"

    if [[ -z "$value" ]]; then
        local detected
        if detected=$("$detector"); then
            printf "  ${YELLOW}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}not set — candidate at %s (confirmed per run)${RESET}\n" \
                "$WARN" "$var_name" "$detected"
        else
            printf "  ${YELLOW}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}not set — %s${RESET}\n" \
                "$WARN" "$var_name" "$purpose"
        fi
        return 1
    fi

    if [[ ! -d "$value" ]]; then
        printf "  ${RED}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}%s (not a directory)${RESET}\n" "$CROSS" "$var_name" "$value"
        return 1
    fi

    printf "  ${GREEN}%s${RESET} ${BOLD}%-18s${RESET} ${DIM}%s${RESET}\n" "$CHECK" "$var_name" "$value"
    return 0
}

run_doctor() {
    local missing_required=0

    echo ""
    echo "${BOLD}wp-ops doctor${RESET} ${DIM}$(get_version)${RESET}"
    echo ""

    echo "${BOLD}Core${RESET}"
    check_binary "git" "version control, release scripts" "required" || missing_required=1
    check_binary "curl" "redirect checks, 404 checks, webhooks" "required" || missing_required=1
    echo ""

    echo "${BOLD}WordPress & Trellis${RESET}"
    check_binary "wp" "WP-CLI scripts (wp-cli/, bedrock/)" "optional" || true
    check_binary "ansible-playbook" "Trellis playbooks (trellis/)" "optional" || true
    check_binary "trellis" "Trellis CLI" "optional" || true
    check_binary "composer" "Bedrock dependency management" "optional" || true
    echo ""

    echo "${BOLD}Images & patterns${RESET}"
    check_binary "magick" "batch resize, trim/center screenshots" "optional" || true
    check_binary "cwebp" "WebP conversion" "optional" || true
    check_binary "node" "Playwright screenshots, sharp conversion" "optional" || true
    echo ""

    echo "${BOLD}Git & release${RESET}"
    check_binary "gh" "PR creation, releases, traffic stats" "optional" || true
    check_binary "svn" "WordPress.org plugin deploys" "optional" || true
    check_binary "zip" "packaging plugin/theme release assets" "optional" || true
    echo ""

    echo "${BOLD}Remote & sync${RESET}"
    check_binary "ssh" "remote monitors, screenshots, post counts" "optional" || true
    check_binary "rsync" "theme and package sync" "optional" || true
    echo ""

    echo "${BOLD}Helpers${RESET}"
    check_binary "jq" "JSON parsing in several scripts" "optional" || true
    check_binary "fzf" "fuzzy command picker in 'wp-ops'" "optional" || true
    echo ""

    # The log monitors (traffic/security/ai-bot) read /srv/www/<site>/logs/
    # directly and use GNU `date -d`, and run-monitoring.sh is invoked as
    # `ssh host 'bash -s' < run-monitoring.sh`. They execute on the server, so
    # checking their dependencies against this machine would be misleading.
    echo "${BOLD}Server-side${RESET} ${DIM}(not checked here — these run on the server)${RESET}"
    printf "  ${DIM}%s %-18s %s${RESET}\n" "·" "gawk" "time filtering in the Nginx log monitors"
    printf "  ${DIM}%s %-18s %s${RESET}\n" " " "" "Ubuntu ships mawk by default, so gawk may be absent:"
    printf "  ${DIM}%s %-18s %s${RESET}\n" " " "" "check with  ssh web@host 'command -v gawk'"
    echo ""

    echo "${BOLD}Environment${RESET}"
    check_env_dir "TRELLIS_DIR" "needed by trellis/ playbooks" detect_trellis_dir || true
    check_env_dir "WP_SITE_DIR" "needed by wp-cli/ and bedrock/ scripts" detect_wp_site_dir || true
    echo ""

    local command_count
    command_count=$(get_all_commands | wc -l | tr -d ' ')
    echo "${BOLD}Catalog${RESET}"
    printf "  ${GREEN}%s${RESET} ${DIM}%s commands discovered in %s${RESET}\n" "$CHECK" "$command_count" "$REPO_ROOT"
    echo ""

    if [[ $missing_required -eq 1 ]]; then
        echo "${RED}${CROSS} Missing a required tool — install it before continuing.${RESET}"
        echo ""
        return 1
    fi

    echo "${GREEN}${CHECK} Core tools present. Optional ones are only needed by the commands that use them.${RESET}"
    echo ""
    return 0
}

# =============================================================================
# Interactive Menu
# =============================================================================

# With ~65 commands across 8 categories, drilling category -> command via
# `select` means a lot of scrolling. When fzf is available, skip straight to
# fuzzy-matching the whole catalog (name and description) with the script's
# header comment as a preview.
fzf_menu() {
    local selection
    selection=$(
        while IFS='|' read -r cmd_key description; do
            # Plain text, not colour: fzf matches against what it's given, so a
            # tagged row stays searchable by typing "server".
            if is_server_side_command "$cmd_key"; then
                printf "%s\t(server) %s\n" "$cmd_key" "$description"
            else
                printf "%s\t%s\n" "$cmd_key" "$description"
            fi
        done < "$COMMAND_FILE" | sort | fzf \
            --delimiter='\t' \
            --with-nth=1,2 \
            --prompt='wp-ops > ' \
            --header='Type to filter · Enter to run · Esc to quit' \
            --height=80% \
            --reverse \
            --preview="head -40 ${REPO_ROOT}/{1}.* 2>/dev/null" \
            --preview-window='right:55%:wrap'
    ) || return 1

    [[ -z "$selection" ]] && return 1

    local cmd_key="${selection%%$'\t'*}"

    echo ""
    printf "  ${BOLD}%s${RESET}\n" "$cmd_key"
    printf "  ${DIM}%s${RESET}\n" "$(get_description "$cmd_key")"
    echo ""

    local extra_args=()
    read -r -p "Arguments (leave blank for none, --help for usage): " -a extra_args

    echo ""
    # Guard against set -e: a failing command shouldn't abort the picker loop.
    execute_command "$cmd_key" "${extra_args[@]+"${extra_args[@]}"}" || true
    return 0
}

interactive_menu() {
    # fzf_menu returns non-zero when the user escapes out of the picker, which
    # is how they quit the loop.
    if command -v fzf >/dev/null 2>&1; then
        while true; do
            fzf_menu || return 0
            echo ""
            local again
            read -r -p "Pick another command? [Y/n] " again
            [[ "$again" =~ ^[Nn] ]] && return 0
            echo ""
        done
    fi

    local categories=()
    local category

    for category in $(get_active_categories); do
        categories+=("$category")
    done
    categories+=("Quit")

    while true; do
        echo "${BOLD}Select a category:${RESET}"
        echo ""

        local PS3="${CYAN}#? ${RESET}"
        local category_choice
        select category_choice in "${categories[@]}"; do
            if [[ -z "$category_choice" ]]; then
                echo "${YELLOW}Invalid selection.${RESET}"
                break
            fi

            if [[ "$category_choice" == "Quit" ]]; then
                return 0
            fi

            echo ""
            interactive_command_menu "$category_choice" || true
            break
        done
        echo ""
    done
}

interactive_command_menu() {
    local category="$1"

    print_category_commands "$category" || return 0

    local cmd_list
    cmd_list=$(get_category_commands "$category")

    # Select choices use the path relative to the category (e.g.
    # "release/release-plugin") instead of the full command_key, since the
    # catalog above already grouped/labeled everything by subdirectory.
    local commands=()
    local cmd_key
    for cmd_key in $(echo "$cmd_list" | tr ',' '\n' | sort); do
        commands+=("${cmd_key#${category}/}")
    done
    commands+=("Back")

    local PS3="${CYAN}#? ${RESET}"
    local command_choice
    select command_choice in "${commands[@]}"; do
        if [[ -z "$command_choice" ]]; then
            echo "${YELLOW}Invalid selection.${RESET}"
            break
        fi

        if [[ "$command_choice" == "Back" ]]; then
            return 0
        fi

        local full_command_key="${category}/${command_choice}"
        local description
        description=$(get_description "$full_command_key")
        echo ""
        echo "${DIM}${description}${RESET}"
        echo ""

        local extra_args=()
        read -r -p "Arguments (leave blank for none): " -a extra_args

        echo ""
        # Guard against set -e: a failed command must return control to the
        # interactive menu, not abort the whole wp-ops session.
        execute_command "$full_command_key" "${extra_args[@]+"${extra_args[@]}"}" || true
        break
    done
}

