print_search_results() {
    local term="$1"

    if [[ -z "$term" ]]; then
        echo "${RED}${CROSS} Usage: wp-ops search <term>${RESET}"
        return 1
    fi

    local matches
    matches=$(grep -i -- "$term" "$COMMAND_FILE" 2>/dev/null | sort || true)

    if [[ -z "$matches" ]]; then
        echo "${YELLOW}No commands match '${term}'.${RESET}"
        echo ""
        echo "Run ${BOLD}wp-ops${RESET} to browse everything by category."
        return 1
    fi

    local count
    count=$(echo "$matches" | wc -l | tr -d ' ')
    local noun="matches"
    [[ "$count" -eq 1 ]] && noun="match"

    echo "${BOLD}${count} ${noun} for '${term}':${RESET}"
    echo ""

    local line cmd_key description tag
    while IFS= read -r line; do
        cmd_key="${line%%|*}"
        description="${line#*|}"
        tag=""
        is_server_side_command "$cmd_key" && tag="${YELLOW}(server)${RESET} "
        printf "  ${CYAN}%-40s${RESET} %s${DIM}%s${RESET}\n" "$cmd_key" "$tag" "$description"
    done <<< "$matches"
    echo ""
}

