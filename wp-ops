main() {
    discover_commands
    
    if [[ $# -eq 0 ]]; then
        print_header

        if [[ -t 0 && -t 1 ]]; then
            interactive_menu
            return $?
        fi

        print_usage
        print_categories
        echo "Run 'wp-ops search <term>' to find a command"
        echo "Run 'wp-ops doctor' to check dependencies and environment"
        echo "Run 'wp-ops --json' for machine-readable command list"
        return 0
    fi
    
    case "${1:-}" in
        --help|-h)
            print_header
            print_usage
            print_categories
            echo "Run 'wp-ops search <term>' to find a command"
            echo "Run 'wp-ops doctor' to check dependencies and environment"
            echo "Run 'wp-ops --json' for machine-readable command list"
            return 0
            ;;
        --version|-v)
            echo "wp-ops $(get_version)"
            echo "$(get_all_commands | wc -l | tr -d ' ') commands from ${REPO_ROOT}"
            return 0
            ;;
        --json)
            print_json
            return 0
            ;;
        --completion)
            print_completion
            return 0
            ;;
        search|--search)
            print_search_results "${2:-}"
            return $?
            ;;
        doctor|--doctor)
            run_doctor
            return $?
            ;;
    esac
    
    local category=""
    local command=""
    local remaining_args=("$@")
    local cat

    # An optional leading category ("wp-ops trellis database-backup") narrows
    # the lookup; without one the whole catalog is searched.
    for cat in "${CATEGORIES[@]}"; do
        if [[ "${remaining_args[0]}" == "$cat" ]]; then
            category="$cat"
            remaining_args=("${remaining_args[@]:1}")
            break
        fi
    done

    if [[ ${#remaining_args[@]} -gt 0 ]]; then
        local candidate="${remaining_args[0]}"

        # "wp-ops trellis --help" lists the category rather than looking for a
        # command literally named "--help".
        if [[ -n "$category" && ( "$candidate" == "--help" || "$candidate" == "-h" ) ]]; then
            remaining_args=("${remaining_args[@]:1}")
            candidate=""
        fi

        if [[ -n "$candidate" ]]; then
            if grep -q "^${candidate}|" "$COMMAND_FILE" 2>/dev/null; then
                # Exact full command key, e.g. "scripts/release/release-plugin".
                command="$candidate"
                remaining_args=("${remaining_args[@]:1}")
            else
                # Bare name, e.g. "release-plugin". Prefer a match inside the
                # named category, then fall back to the whole catalog.
                local matches
                matches=$(find_commands_by_basename "$candidate" "$category")
                if [[ -z "$matches" && -n "$category" ]]; then
                    matches=$(find_commands_by_basename "$candidate")
                fi

                local match_count
                match_count=$(echo "$matches" | grep -c . || true)

                if [[ "$match_count" -gt 1 ]]; then
                    print_ambiguous "$candidate" $matches
                    return 1
                fi

                if [[ "$match_count" -eq 1 ]]; then
                    command="$matches"
                    remaining_args=("${remaining_args[@]:1}")
                fi
            fi
        fi
    fi

    if [[ -n "$command" ]]; then
        execute_command "$command" "${remaining_args[@]+"${remaining_args[@]}"}"
        return $?
    fi

    if [[ -n "$category" ]]; then
        print_category_commands "$category" || return 0
        echo "Usage: wp-ops $category <command> [args...]"
        return 0
    fi

    # Nothing resolved. One error with a way forward beats reprinting the whole
    # catalog on top of it.
    echo "${RED}${CROSS} Unknown command or category: ${remaining_args[0]}${RESET}"
    echo ""
    local suggestion
    suggestion=$(suggest_similar "${remaining_args[0]}")
    if [[ -n "$suggestion" ]]; then
        echo "${YELLOW}Did you mean:${RESET}"
        echo "$suggestion"
        echo ""
    fi
    echo "Try ${BOLD}wp-ops search ${remaining_args[0]}${RESET}, or ${BOLD}wp-ops${RESET} to browse everything."
    return 1
}

main "$@"
